
@model List<gestion_restaurant.Models.Commande>

<link rel="stylesheet" href="~/css/mes-commandes.css" />

<div class="container my-5">
    <h1 class="page-title">MES COMMANDES</h1>

    @foreach (var commande in Model)
    {
        <div class="commande-card">
            <div class="commande-header">
                <h4>Commande @commande.Id</h4>

                <span class="badge-statut">
                    @commande.Statut
                </span>
            </div>

            <p class="commande-produits">
                @string.Join(", ", commande.CommandeItems.Select(i => i.Product.Nom))
            </p>
        </div>
    }
</div>
