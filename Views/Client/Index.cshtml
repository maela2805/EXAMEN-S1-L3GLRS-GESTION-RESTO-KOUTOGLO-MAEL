@model gestion_restaurant.ViewModels.ClientCatalogueViewModel

@{
    ViewData["Title"] = "Catalogue";
}

<link rel="stylesheet" href="~/css/catalogue.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />

<div class="container my-5">

    <div class="catalogue-header mb-5">
        <h1 class="catalogue-title text-center">NOTRE CATALOGUE</h1>
        <p class="catalogue-subtitle text-center">
            Découvrez notre sélection de burgers, menus et compléments
        </p>

        <div class="catalogue-actions d-flex justify-content-between align-items-center flex-wrap gap-3 mt-4">

            <form method="get" asp-controller="Client" asp-action="Index" class="search-box">
                <i class="bi bi-search"></i>
                <input type="text"
                       name="search"
                       placeholder="Rechercher un produit"
                       value="@Context.Request.Query["search"]" />
            </form>

            <div class="catalogue-filters d-flex gap-2 flex-wrap">
                <a asp-action="Index" asp-route-filter="all"
                   class="filter-btn @(Model.ActiveFilter == "all" ? "active" : "outline")">
                    Tout
                </a>

                <a asp-action="Index" asp-route-filter="burgers"
                   class="filter-btn @(Model.ActiveFilter == "burgers" ? "active" : "outline")">
                    Burgers
                </a>

                <a asp-action="Index" asp-route-filter="menus"
                   class="filter-btn @(Model.ActiveFilter == "menus" ? "active" : "outline")">
                    Menus
                </a>

                <a asp-action="Index" asp-route-filter="complements"
                   class="filter-btn @(Model.ActiveFilter == "complements" ? "active" : "outline")">
                    Compléments
                </a>
            </div>

        </div>
    </div>

    @if (Model.Burgers.Any())
    {
        <h3 class="mb-3">BURGERS</h3>
        <div class="row g-4 mb-5">
            @foreach (var p in Model.Burgers)
            {
                <div class="col-md-4">
                    <div class="card product-card">
                        <img src="@p.Image" class="card-img-top" alt="@p.Nom">
                        <div class="card-body">
                            <h5>@p.Nom</h5>
                            <p class="text-muted small">@p.Description</p>

                           <div class="d-flex justify-content-between align-items-center">
                                <span class="price">@p.Prix FCFA</span>

                                <a asp-action="Details" style="text-decoration: none;"
                                   asp-route-id="@p.Id"
                                   class="btn-add">
                                    +
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (Model.Menus.Any())
    {
        <h3 class="mb-3">MENUS</h3>
        <div class="row g-4 mb-5">
            @foreach (var p in Model.Menus)
            {
                <div class="col-md-4">
                    <div class="card product-card">
                        <img src="@p.Image" class="card-img-top" alt="@p.Nom">
                        <div class="card-body">
                            <h5>@p.Nom</h5>
                            <p class="text-muted small">@p.Description</p>

                            <div class="d-flex justify-content-between align-items-center">
                                <span class="price">@p.Prix FCFA</span>

                                <a asp-action="Details" style="text-decoration: none;"
                                   asp-route-id="@p.Id"
                                   class="btn-add">
                                    +
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- COMPLEMENTS -->
    @if (Model.Complements.Any())
    {
        <h3 class="mb-3">COMPLÉMENTS</h3>
        <div class="row g-4">
            @foreach (var c in Model.Complements)
            {
                <div class="col-md-3">
                    <div class="card product-card text-center">
                        <img src="@c.Image" class="card-img-top" alt="@c.Nom">
                        <div class="card-body">
                            <h6>@c.Nom</h6>
                            <span class="price">@c.Prix FCFA</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
