@model ClientCatalogueViewModel
@using gestion_restaurant.ViewModels

@{
    ViewData["Title"] = "Catalogue";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/catalogue.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">


<div class="container my-5">

   <div class="catalogue-header">

        <h1 class="catalogue-title">NOTRE CATALOGUE</h1>
        <p class="catalogue-subtitle">
            Découvrez notre sélection de burgers, menus et compléments
        </p>

        <div class="catalogue-actions">

            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Rechercher un produit">
            </div>

            <div class="catalogue-filters">
                <button class="filter-btn active">Tout</button>
                <button class="filter-btn outline">Burgers</button>
                <button class="filter-btn outline">Menus</button>
                <button class="filter-btn outline">Compléments</button>
            </div>

        </div>
    </div>



    <h3 class="mb-3">BURGERS</h3>
    <div class="row g-4">
        @foreach (var p in Model.Burgers)
        {
            <div class="col-md-4">
                <div class="card product-card">
                    <img src="@p.Image" class="card-img-top" alt="@p.Nom">
                    <div class="card-body">
                        <h5>@p.Nom</h5>
                        <p class="text-muted small">@p.Description</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="price">@p.Prix FCFA</span>
                            <button class="btn btn-warning rounded-circle">+</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>


    <h3 class="mt-5 mb-3">MENUS</h3>
    <div class="row g-4">
        @foreach (var p in Model.Menus)
        {
            <div class="col-md-4">
                <div class="card product-card">
                    <img src="@p.Image" class="card-img-top" alt="@p.Nom">
                    <div class="card-body">
                        <h5>@p.Nom</h5>
                        <p class="text-muted small">@p.Description</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="price">@p.Prix FCFA</span>
                            <button class="btn btn-warning rounded-circle">+</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <h3 class="mt-5 mb-3">COMPLÉMENTS</h3>
    <div class="row g-4">
        @foreach (var c in Model.Complements)
        {
            <div class="col-md-3">
                <div class="card product-card text-center">
                    <img src="@c.Image" class="card-img-top" alt="@c.Nom">
                    <div class="card-body">
                        <h6>@c.Nom</h6>
                        <span class="price">@c.Prix FCFA</span>
                    </div>
                </div>
            </div>
        }
    </div>


</div>
