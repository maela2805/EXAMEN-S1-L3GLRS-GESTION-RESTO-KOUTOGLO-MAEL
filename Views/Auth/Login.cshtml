@model gestion_restaurant.ViewModels.LoginViewModel

@{
    Layout = "_LoginLayout";
}

<div class="login-card">
    <h2>CONNEXION</h2>

    @if (ViewBag.Error != null)
    {
        <div class="login-error">@ViewBag.Error</div>
    }

    <form method="post">
        <label>LOGIN</label>
        <input asp-for="Login" />

        <label>PASSWORD</label>
        <input asp-for="Password" type="password" />

        <a href="#" class="create-account">Créer un compte</a>

        <button type="submit">Se connecter</button>
    </form>
</div>
