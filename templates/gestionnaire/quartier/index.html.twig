{% extends 'gestionnaire/_layout.html.twig' %}

{% block title %}Quartiers{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold">Quartiers</h4>
        <small class="text-muted">Gestion des quartiers par zone</small>
    </div>

    <a href="{{ path('gestionnaire_quartier_new') }}"
       class="btn btn-warning">
        Ajouter quartier
    </a>
</div>

<div class="row g-4">
    {% for quartier in quartiers %}
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column justify-content-between">

                    <div>
                        <h6 class="fw-bold mb-1">
                            {{ quartier.libelle }}
                        </h6>

                        <small class="text-muted">
                            Zone {{ quartier.zone.id }}
                        </small>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <a href="{{ path('gestionnaire_quartier_edit', {id: quartier.id}) }}"
                           class="btn btn-sm btn-outline-secondary">
                            Modifier
                        </a>

                        <form method="post"
                              action="{{ path('gestionnaire_quartier_delete', {id: quartier.id}) }}"
                              onsubmit="return confirm('Archiver ce quartier ?')">
                            <button class="btn btn-sm btn-outline-danger">
                                Archiver
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            <p class="text-muted">Aucun quartier enregistré.</p>
        </div>
    {% endfor %}
</div>
{% endblock %}
