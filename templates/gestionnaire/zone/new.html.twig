{% extends 'gestionnaire/_layout.html.twig' %}

{% block title %}Ajouter une zone{% endblock %}

{% block content %}
<div class="d-flex justify-content-center align-items-center" style="min-height:80vh">
    <div class="card shadow-sm card-form">
        <div class="card-body p-4">

            <h4 class="text-center mb-4 fw-bold">
                ➕ Ajouter une zone
            </h4>

            {{ form_start(form) }}

            <div class="mb-4">
                {{ form_label(form.tarif) }}
                {{ form_widget(form.tarif, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="d-flex justify-content-between">
                <a href="{{ path('gestionnaire_zones') }}"
                   class="btn btn-outline-secondary">
                    Annuler
                </a>

                <button class="btn btn-warning">
                    Ajouter
                </button>
            </div>

            {{ form_end(form) }}

        </div>
    </div>
</div>
{% endblock %}
