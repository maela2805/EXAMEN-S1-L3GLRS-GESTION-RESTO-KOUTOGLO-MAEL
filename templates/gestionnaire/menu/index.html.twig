{% extends 'gestionnaire/_layout.html.twig' %}

{% block title %}Menus{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold">Menus</h4>
        <small class="text-muted">
            Gérez vos menus (Burger + frite + boisson)
        </small>
    </div>

    <a href="{{ path('gestionnaire_menu_new') }}"
       class="btn btn-warning">
        Ajouter menu
    </a>
</div>

<div class="mb-4" style="max-width:300px;">
    <input type="text"
           class="form-control"
           placeholder="Rechercher un menu...">
</div>

<div class="row g-4">
    {% for menu in menus %}
        {% set product = menu.product %}
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <img src="{{ product.image ?? asset('images/menu-placeholder.png') }}"
                     class="card-img-top"
                     style="height:160px; object-fit:cover;">

                <div class="card-body">
                    <h6 class="fw-bold mb-1">
                        {{ product.nom }}
                    </h6>

                    <small class="text-muted d-block mb-2">
                        Burger + frite + boisson
                    </small>

                    <strong class="text-warning">
                        {{ product.prix }} FCFA
                    </strong>

                    <div class="d-flex gap-2 mt-3">
                        <a href="{{ path('gestionnaire_menu_edit', {id: menu.product.id}) }}"
                            class="btn btn-sm btn-outline-secondary">
                                Modifier
                        </a>


                        <form method="post"
                            action="{{ path('gestionnaire_menu_delete', {id: menu.product.id}) }}"
                            onsubmit="return confirm('Archiver ce menu ?')">
                            <button class="btn btn-sm btn-outline-danger">
                                Archiver
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <p class="text-muted">Aucun menu enregistré</p>
    {% endfor %}
</div>
{% endblock %}
