{% extends 'base.html.twig' %}

{% block body %}
<div>

    {# SIDEBAR FIXE #}
    <aside class="sidebar">
        <div class="mb-4">
            <div class="d-flex align-items-center gap-2">
                <div class="logo">BB</div>
                <strong>Brasil Burger</strong>
            </div>
            <small class="text-secondary">Gestionnaire</small>
        </div>

        <ul class="nav flex-column gap-1">

    <li class="nav-item">
    <a class="nav-link
       {{ app.request.attributes.get('_route') starts with 'gestionnaire_dashboard' ? 'active' : '' }}"
       href="{{ path('gestionnaire_dashboard') }}">
        🧭 Tableau de bord
    </a>
</li>


    {# 🍔 BURGERS #}
    <li class="nav-item">
        <a class="nav-link
           {{ app.request.attributes.get('_route') starts with 'gestionnaire_burger' ? 'active' : '' }}"
           href="{{ path('gestionnaire_burgers') }}">
            🍔 Burgers
        </a>
    </li>

    {# 📦 MENUS #}
    <li class="nav-item">
        <a class="nav-link
           {{ app.request.attributes.get('_route') starts with 'gestionnaire_menu' ? 'active' : '' }}"
           href="{{ path('gestionnaire_menus') }}">
            📦 Menus
        </a>
    </li>

    {# 🧂 COMPLÉMENTS #}
    <li class="nav-item">
        <a class="nav-link
           {{ app.request.attributes.get('_route') starts with 'gestionnaire_complement' ? 'active' : '' }}"
           href="{{ path('gestionnaire_complements') }}">
            🧂 Compléments
        </a>
    </li>

    {# 📦 COMMANDES #}
    <li class="nav-item">
        <a class="nav-link
        {{ app.request.attributes.get('_route') starts with 'gestionnaire_commandes'
            or app.request.attributes.get('_route') starts with 'gestionnaire_livraisons'
            ? 'active' : '' }}"
        href="{{ path('gestionnaire_commandes') }}">
            📦 Commandes
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link"
        href="{{ path('gestionnaire_livraison_creer') }}">
            🚚 Créer une livraison
        </a>
    </li>


    {# 📍 ZONES #}
    <li class="nav-item">
        <a class="nav-link
           {{ app.request.attributes.get('_route') starts with 'gestionnaire_zone' ? 'active' : '' }}"
           href="{{ path('gestionnaire_zones') }}">
            📍 Zones
        </a>
    </li>

    {# 🏘️ QUARTIERS #}
    <li class="nav-item">
        <a class="nav-link
           {{ app.request.attributes.get('_route') starts with 'gestionnaire_quartier' ? 'active' : '' }}"
           href="{{ path('gestionnaire_quartiers') }}">
            🏘️ Quartiers
        </a>
    </li>

    {# 🛵 LIVREURS #}
    <li class="nav-item">
        <a class="nav-link
           {{ app.request.attributes.get('_route') starts with 'gestionnaire_livreur' ? 'active' : '' }}"
           href="{{ path('gestionnaire_livreurs') }}">
            🛵 Livreurs
        </a>
    </li>

</ul>

    </aside>

    {# CONTENU #}
    <main class="main-content">
        {% block content %}{% endblock %}
    </main>

</div>
{% endblock %}
