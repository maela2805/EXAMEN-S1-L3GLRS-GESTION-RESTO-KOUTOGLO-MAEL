{% extends 'gestionnaire/_layout.html.twig' %}

{% block title %}Modifier un complément{% endblock %}

{% block content %}
<div class="d-flex justify-content-center align-items-center" style="min-height:80vh">
    <div class="card shadow-sm card-form">
        <div class="card-body p-4">

            <h4 class="text-center mb-4 fw-bold">
                <i class="bi bi-pencil-square"></i> Modifier le complément
            </h4>

            <form method="post" enctype="multipart/form-data">

                <div class="mb-3">
                    <label class="form-label">Nom</label>
                    <input type="text"
                           name="nom"
                           class="form-control"
                           value="{{ complement.nom }}"
                           required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Prix (FCFA)</label>
                    <input type="number"
                           name="prix"
                           class="form-control"
                           value="{{ complement.prix }}"
                           required>
                </div>

                {% if complement.typecomplement == 'FRITE' %}
                    <div class="mb-3">
                        <label class="form-label">Taille</label>
                        <input type="text"
                               name="taille"
                               class="form-control"
                               value="{{ frite.taille }}">
                    </div>
                {% endif %}

                {% if complement.typecomplement == 'BOISSON' %}
                    <div class="mb-3">
                        <label class="form-label">Volume</label>
                        <input type="text"
                               name="volume"
                               class="form-control"
                               value="{{ boisson.volume }}">
                    </div>
                {% endif %}

                <div class="mb-4">
                    <label class="form-label">Image</label>
                    <input type="file" name="image" class="form-control">
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ path('gestionnaire_complements') }}"
                       class="btn btn-outline-secondary">
                        Annuler
                    </a>

                    <button class="btn btn-warning">
                        Modifier
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>
{% endblock %}
