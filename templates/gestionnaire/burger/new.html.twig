{% extends 'gestionnaire/_layout.html.twig' %}

{% block title %}Ajouter un burger{% endblock %}

{% block content %}
<div class="d-flex justify-content-center align-items-center" style="min-height:80vh">
    <div class="card shadow-sm card-form">
        <div class="card-body p-4">

            <h4 class="text-center mb-4 fw-bold">
                <i class="bi bi-plus-circle"></i> Ajouter un burger
            </h4>

            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

            <div class="mb-3">
                {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.prix, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.prix, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="mb-4">
                {{ form_label(form.imageFile, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="d-flex justify-content-between">
                <a href="{{ path('gestionnaire_burgers') }}" class="btn btn-light px-4">
                    Annuler
                </a>
                <button class="btn btn-warning px-4">
                    Ajouter
                </button>
            </div>

            {{ form_end(form) }}

        </div>
    </div>
</div>
{% endblock %}